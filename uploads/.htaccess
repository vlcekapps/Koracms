# Zakázat spouštění skriptů v adresáři uploads
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|cgi|pl|py|rb|sh|asp|aspx|jsp|html?|xhtml|shtml|xml|js|mjs)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Child rewrite rules must retain every inherited private-upload restriction.
    RewriteRule ^(forms|backups|gallery|places|podcasts)/ - [F,L,NC]
    RewriteRule ^downloads/(?!images/) - [F,L,NC]
    RewriteRule ^media/(?!.*\.(jpg|jpeg|png|gif|webp|mp3|m4a|mp4|ogg|wav|aac|flac|webm|ogv|mov|pdf|zip|vtt|csv|doc|docx|xls|xlsx)$) - [F,L,NC]
</IfModule>
